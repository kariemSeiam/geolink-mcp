{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-16/server.schema.json",
  "name": "io.github.kariemseiam/geolink-mcp",
  "description": "Geocoding, place search, directions, distance matrix, nearest-by-road-time ranking, and grid-based area coverage sweeps \u2014 GeoLink for AI agents.",
  "status": "active",
  "repository": {
    "url": "https://github.com/kariemSeiam/geolink-mcp",
    "source": "github"
  },
  "version": "1.6.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "geolink-mcp",
      "version": "1.6.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GEOLINK_API_KEY",
          "description": "GeoLink API key \u2014 free tier at https://geolink-eg.com/register",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "GEOLINK_BASE_URL",
          "description": "Override upstream base URL (staging/mocks)",
          "isRequired": false,
          "default": "https://www.geolink-eg.com"
        },
        {
          "name": "GEOLINK_DEFAULT_LANGUAGE",
          "description": "Default response language",
          "isRequired": false,
          "default": "en"
        },
        {
          "name": "GEOLINK_DEFAULT_COUNTRY",
          "description": "Default country bias (unset = none)",
          "isRequired": false,
          "default": ""
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.geolink-eg.com/mcp"
    }
  ]
}
