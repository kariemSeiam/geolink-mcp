# GeoLink MCP Server — environment variables
# Copy this to .env and fill in your key
# ─────────────────────────────────────────────

# REQUIRED — get a key at https://geolink-eg.com/register
GEOLINK_API_KEY=your_key_here

# Optional overrides (defaults shown)
GEOLINK_BASE_URL=https://www.geolink-eg.com
GEOLINK_DEFAULT_LANGUAGE=en
GEOLINK_DEFAULT_COUNTRY=
GEOLINK_TIMEOUT_MS=30000
GEOLINK_MAX_MATRIX_CELLS=100
GEOLINK_SWEEP_MAX_POINTS=200
GEOLINK_SWEEP_CONCURRENCY=4
