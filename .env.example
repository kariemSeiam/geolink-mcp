# GeoLink MCP Server — environment variables
# Copy this to .env and fill in your key
# ─────────────────────────────────────────────

# REQUIRED — get a key at https://geolink-eg.com/register
GEOLINK_API_KEY=your_key_here

# Optional overrides (defaults shown)
GEOLINK_BASE_URL=https://www.geolink-eg.com
GEOLINK_DEFAULT_LANGUAGE=en
GEOLINK_DEFAULT_COUNTRY=
GEOLINK_TIMEOUT_MS=30000
GEOLINK_MAX_MATRIX_CELLS=100
GEOLINK_SWEEP_MAX_POINTS=200
GEOLINK_SWEEP_CONCURRENCY=4

# --- Mounting on the main site -------------------------------------------
# Where this server sits on its host. Default /mcp. The authorization
# endpoints hang off this prefix so they cannot collide with the site's own
# routes; the two well-known documents stay at the root, where the RFCs put
# them and where a client will look.
# GEOLINK_MCP_PATH=/mcp
#
# The origin clients reach it on. Forwarded headers are the fallback, but set
# this explicitly behind a proxy: if a layer above strips them, the metadata
# quietly starts advertising an internal address no client can reach.
# GEOLINK_PUBLIC_URL=https://geolink-eg.com
